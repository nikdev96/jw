# Production Environment Template
# Copy this file to .env.prod and fill with actual values

# Database (connects to docker-compose.yml PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:your_production_password@postgres:5432/botshop

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_production_bot_token_from_botfather
MANAGER_CHAT_ID=your_production_manager_chat_id

# Production URLs
FRONTEND_URL=https://your-production-domain.com
FRONTEND_DEV_URL=https://your-production-domain.com

# Production Settings (always false in production)
DEBUG=false

# Note: 
# - Use docker-compose.yml for production PostgreSQL
# - Deploy backend/frontend separately to cloud services
# - Backend will connect to this database via DATABASE_URL